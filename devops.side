        },
        {
          "id": "22452a69-1b83-4558-a3dc-a4c604ae3518",
          "comment": "Validation 4: positive flow - typing a name and clicking the button shows greeting",
          "command": "type",
          "target": "id=myInput",
          "targets": [],

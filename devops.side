        {
          "id": "d237aff0-33eb-42ed-b676-9ff7b9113bdc",
          "comment": "Validation 1: page title is correct",
          "command": "assertTitle",
          "target": "Simple Page",
          "targets": [],
          "value": ""
        },
        {
          "id": "16a019f4-4b57-44f2-9e02-e04940780094",
          "comment": "Validation 2: input textbox exists",
          "command": "verifyElementPresent",
          "target": "id=myInput",
          "targets": [],
          "value": ""
        },
        {
          "id": "4c20d346-f19d-430e-8afa-7531562c8276",
          "comment": "Validation 3: button exists and has correct text",
          "command": "assertText",
